# Ground-origin Falcon Kick changes kinetics at a ledge immediately but keeps
# DownSpecial until the source frame-32 continuation gate.
neutral
stick_y -80
special down
frames 1
special up
frames 11
expect_state FALCON_KICK_GROUND
frames 1
expect_attack 1 1
pos_y 10000
host_fall
frames 1
expect_state FALCON_KICK_GROUND
expect_grounded 0 0
roundtrip
frames 19
expect_state FALCON_KICK_GROUND
frames 1
expect_state FALCON_KICK_GROUND_AIR
expect_grounded 0 0

# A low side wall during Ground SpecialLw's authored flag1/contact window
# enters the dedicated rebound state, clamps the private mirror before it can
# cross, and forces air kinetics before ordinary landing reconciliation.
reset
neutral
stick_y -80
special down
frames 1
special up
frames 11
host_wall
frames 1
expect_state FALCON_KICK_BOUND
expect_grounded 0 0
roundtrip

# Late Ground SpecialLw is outside the source flag1 Bound window. It must
# consume the remaining forward root at the native wall face rather than
# letting the next endpoint sample tunnel it out of bounds.
reset
neutral
stick_y -80
special down
frames 1
special up
frames 32
expect_state FALCON_KICK_GROUND
pos_x 745
host_wall
frames 1
expect_state WAIT
expect_grounded 1 1
expect_pos_x 745 745
frames 4
expect_pos_x 745 745

# Ground-origin SpecialLw that has already continued into its air spelling
# is likewise not eligible for Bound. A side wall consumes its root and falls
# safely with no carried X.
reset
neutral
stick_y -80
special down
frames 1
special up
frames 11
frames 1
pos_y 10000
host_fall
frames 1
frames 19
frames 1
expect_state FALCON_KICK_GROUND_AIR
pos_x 745
host_wall
frames 1
expect_state FALL
expect_grounded 0 0
expect_vel_air_x 0 0
expect_pos_x 745 745
frames 4
expect_pos_x 745 745

# Direct SpecialAirLw has landing-only ProcMap: a side wall must never be
# promoted to Ground SpecialLw Bound. Consume its root and fall safely.
reset
pos_y 1000
host_fall
stick_y -80
special down
frames 1
special up
expect_state FALCON_KICK_AIR
pos_x 745
host_wall
frames 1
expect_state FALL
expect_grounded 0 0
expect_vel_air_x 0 0
expect_pos_x 745 745
frames 4
expect_pos_x 745 745
roundtrip

# An ordinary jump wall collision does not become Falcon Kick Bound.
reset
jump down
frames 4
jump up
frames 1
expect_state JUMP_F
host_wall
frames 1
expect_state JUMP_F
