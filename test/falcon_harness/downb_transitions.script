# Ground-origin Falcon Kick changes kinetics at a ledge immediately but keeps
# DownSpecial until the source frame-32 continuation gate.
neutral
stick_y -80
special down
frames 1
special up
frames 11
expect_state FALCON_KICK_GROUND
frames 1
expect_attack 1 1
pos_y 10000
host_fall
frames 1
expect_state FALCON_KICK_GROUND
expect_grounded 0 0
roundtrip
frames 19
expect_state FALCON_KICK_GROUND
frames 1
expect_state FALCON_KICK_GROUND_AIR
expect_grounded 0 0

# A low side wall during Ground SpecialLw's authored flag1/contact window
# enters the dedicated rebound state, clamps the private mirror before it can
# cross, and forces air kinetics before ordinary landing reconciliation.
reset
neutral
stick_y -80
special down
frames 1
special up
frames 11
host_wall
frames 1
expect_state FALCON_KICK_BOUND
expect_grounded 0 0
roundtrip

# Direct SpecialAirLw has landing-only ProcMap: a side wall preserves its
# aerial status but exposes no crossed source delta or residual horizontal
# speed. It must never be promoted to Ground SpecialLw Bound.
reset
pos_y 1000
host_fall
stick_y -80
special down
frames 1
special up
expect_state FALCON_KICK_AIR
host_wall
frames 1
expect_state FALCON_KICK_AIR
expect_grounded 0 0
roundtrip

# An ordinary jump wall collision does not become Falcon Kick Bound.
reset
jump down
frames 4
jump up
frames 1
expect_state JUMP_F
host_wall
frames 1
expect_state JUMP_F
