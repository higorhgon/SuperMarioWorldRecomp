{
  "format": "falcon-validation/v1",
  "name": "falcon-gm14-move-showcase",
  "mod": {
    "package_id": "super-mario-world.smash64.captain-falcon",
    "feature_id": "captain-falcon",
    "version": "0.1.0",
    "resource_id": "smash64-us-v10"
  },
  "steps": [
    {"op": "wait_ram", "id": "title_ready", "addr": "0x0100", "len": 1, "equals": "0x07", "timeout_frames": 1200, "step_frames": 4},
    {"op": "pulse_input_until_ram", "id": "overworld_ready", "p1": ["start"], "addr": "0x0100", "len": 1, "equals": "0x0e", "timeout_frames": 1800, "hold_frames": 1, "release_frames": 8},
    {"op": "pulse_input_until_ram", "id": "gameplay_ready", "p1": ["a"], "addr": "0x0100", "len": 1, "equals": "0x14", "timeout_frames": 1200, "hold_frames": 1, "release_frames": 8},
    {"op": "step", "frames": 3},
    {"op": "capture", "id": "idle", "wram": [{"name": "game_mode", "addr": "0x0100", "len": 1, "equals": "0x14"}, {"name": "player", "addr": "0x0071", "len": 42}]},
    {"op": "save_state", "id": "idle_checkpoint"},

    {"op": "load_state", "id": "idle_checkpoint"},
    {"op": "input", "p1": ["x"]}, {"op": "step", "frames": 1}, {"op": "input", "p1": null}, {"op": "step", "frames": 1},
    {"op": "capture", "id": "normal_x", "wram": [{"name": "game_mode", "addr": "0x0100", "len": 1, "equals": "0x14"}, {"name": "player", "addr": "0x0071", "len": 42}]},

    {"op": "load_state", "id": "idle_checkpoint"}, {"op": "input", "p1": ["y"]}, {"op": "step", "frames": 42}, {"op": "input", "p1": null},
    {"op": "capture", "id": "falcon_punch_active", "wram": [{"name": "game_mode", "addr": "0x0100", "len": 1, "equals": "0x14"}, {"name": "player", "addr": "0x0071", "len": 42}]},

    {"op": "load_state", "id": "idle_checkpoint"}, {"op": "input", "p1": ["down", "y"]}, {"op": "step", "frames": 12}, {"op": "input", "p1": null},
    {"op": "capture", "id": "falcon_kick_ground", "wram": [{"name": "game_mode", "addr": "0x0100", "len": 1, "equals": "0x14"}, {"name": "player", "addr": "0x0071", "len": 42}]},

    {"op": "load_state", "id": "idle_checkpoint"}, {"op": "input", "p1": ["up", "y"]}, {"op": "step", "frames": 8}, {"op": "input", "p1": null},
    {"op": "capture", "id": "falcon_dive", "wram": [{"name": "game_mode", "addr": "0x0100", "len": 1, "equals": "0x14"}, {"name": "player", "addr": "0x0071", "len": 42}]},

    {"op": "load_state", "id": "idle_checkpoint"}, {"op": "input", "p1": ["b"]}, {"op": "step", "frames": 2}, {"op": "input", "p1": null},
    {"op": "capture", "id": "jump_takeoff", "wram": [{"name": "game_mode", "addr": "0x0100", "len": 1, "equals": "0x14"}, {"name": "player", "addr": "0x0071", "len": 42}]},

    {"op": "input", "p1": ["x"]}, {"op": "step", "frames": 1}, {"op": "input", "p1": null}, {"op": "step", "frames": 1},
    {"op": "capture", "id": "aerial_x", "wram": [{"name": "game_mode", "addr": "0x0100", "len": 1, "equals": "0x14"}, {"name": "player", "addr": "0x0071", "len": 42}]},

    {"op": "input", "p1": ["down", "x"]}, {"op": "step", "frames": 1}, {"op": "input", "p1": null}, {"op": "step", "frames": 1},
    {"op": "capture", "id": "aerial_down_x", "wram": [{"name": "game_mode", "addr": "0x0100", "len": 1, "equals": "0x14"}, {"name": "player", "addr": "0x0071", "len": 42}]},

    {"op": "input", "p1": ["b"]}, {"op": "step", "frames": 1}, {"op": "input", "p1": null}, {"op": "step", "frames": 1},
    {"op": "capture", "id": "aerial_second_jump", "wram": [{"name": "game_mode", "addr": "0x0100", "len": 1, "equals": "0x14"}, {"name": "player", "addr": "0x0071", "len": 42}]}
  ]
}
